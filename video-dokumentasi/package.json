    "@remotion/renderer": "^4.0.543",
    "@remotion/zod-types": "^4.0.543",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "typescript-eslint": "^8.72.2"
  }
