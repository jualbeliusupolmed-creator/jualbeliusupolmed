{
  "name": "kampus-kita",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace & Komunitas Digital Mahasiswa Indonesia",
  "scripts": {
    "dev": "node scripts/dev-with-meta-docs.mjs dev",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && node scripts/dev-with-meta-docs.mjs dev",
    "dev:turbo": "node scripts/dev-with-meta-docs.mjs dev --turbo",
    "build": "npm run sync:meta-docs && next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "cloudflare:build": "node scripts/build-cloudflare.mjs",
    "deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy",
    "preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "smoke:production": "node scripts/cloudflare-smoke.mjs",
    "lint": "eslint src __tests__ scripts next.config.mjs next-sitemap.config.cjs postcss.config.cjs tailwind.config.cjs vitest.config.mjs vitest.setup.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run check:meta-docs && npm run lint && npm run test && npm run build",
    "sync:meta-docs": "node scripts/sync-meta-docs.mjs sync",
    "check:meta-docs": "node scripts/sync-meta-docs.mjs check",
    "watch:meta-docs": "node scripts/sync-meta-docs.mjs watch",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/functions": "^3.9.7",
    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.21.0",
    "marked": "15.0.12",
    "next": "15.5.29",
    "next-sitemap": "^4.2.3",
    "openai": "^6.45.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@img/sharp-wasm32": "^0.35.5",
    "@opennextjs/cloudflare": "^1.20.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "1.9.20",
    "@types/qrcode": "1.5.5",
    "@vinext/cloudflare": "1.4.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "autoprefixer": "^10.4.20",
    "cf": "1.0.0-rc.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.13",
    "vinext": "1.4.6",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "brace-expansion": "1.1.21",
    "postcss": "^8.5.26",
    "satori": {
      "fflate": "0.7.5"
    },
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261117.1": true,
    "workerd@1.20261119.1": true
  },
  "type": "module"
}
