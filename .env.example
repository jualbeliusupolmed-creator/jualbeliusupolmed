# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===== Database (Supabase PostgreSQL) =====
DATABASE_URL="postgresql://postgres.[db]:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[db]:[password]@[host]:5432/postgres"

# ===== DOKU (Jokul Checkout) =====
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false

# ===== Fonnte (WhatsApp) =====
FONNTE_TOKEN=
FONNTE_WA_GROUP_ID=

# ===== Admin =====
# Generate dengan: openssl rand -base64 24   (minimal 16 karakter, wajib di production)
ADMIN_PASSWORD=ganti_dengan_password_kuat_minimal_16_karakter
ADMIN_WA=
SUPER_ADMIN_WA=
# Kunci penanda tangan sesi penjual (terpisah dari ADMIN_PASSWORD).
# Generate dengan: openssl rand -base64 32
# Jika tidak diset, fallback ke ADMIN_PASSWORD (berbahaya — ganti sandi admin = logout semua penjual).
SESSION_SECRET=

# ===== Marketplace =====
MARKETPLACE_WA=
NEXT_PUBLIC_MARKETPLACE_WA=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WA_GROUP_LINK=
IPAYMU_VA=
IPAYMU_API_KEY=
NEXT_PUBLIC_IPAYMU_IS_PRODUCTION=false
IPAYMU_IS_PRODUCTION=false
CRON_SECRET=your_cron_secret

# ===== Instagram Content Publishing (server-only) =====
# WAJIB diisi agar auto-post Menfess & Katalog ke Instagram berfungsi.
# Lihat panduan: docs/setup-meta-instagram.md
# Satu pasangan ID/token per akun. JANGAN commit nilai token ke Git.
META_GRAPH_API_VERSION=v24.0
# Akun @usupolmedmenfess — untuk post Menfess
META_MENFESS_IG_USER_ID=
META_MENFESS_IG_ACCESS_TOKEN=
# Akun @katalogusupolmed — untuk post listing aktif
META_KATALOG_IG_USER_ID=
META_KATALOG_IG_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ===== KlikQris (QRIS Payment) =====
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=

# ===== AI / Bots =====
GEMINI_API_KEY=
BAILEYS_API_URL=
BAILEYS_API_TOKEN=

# ===== Web Push (PWA Push Notification) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@example.com
